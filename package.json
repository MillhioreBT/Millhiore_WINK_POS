{
  "name": "millhiore-wink",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit || true",
    "start": "turbo run build --filter=@millhiore/web && bun apps/server/src/main.ts",
    "dev": "turbo run dev --filter=@millhiore/server --filter=@millhiore/web",
    "reset-password": "bun apps/server/src/main.ts reset-password",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome ci . && turbo run typecheck test build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
