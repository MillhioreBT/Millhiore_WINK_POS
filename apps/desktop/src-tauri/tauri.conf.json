{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Millhiore WINK POS",
  "version": "0.1.0",
  "identifier": "com.millhiore.wink",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Millhiore WINK POS",
        "width": 1366,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Millhiore WINK POS",
    "shortDescription": "Punto de venta para comercios venezolanos",
    "longDescription": "Caja, inventario, turnos, IVA e IGTF y tasa del BCV. Libre (MIT) y autohospedado.",
    "category": "Business",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/millhiore-server"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
